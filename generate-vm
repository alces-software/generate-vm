      apt-get update
      apt-get install -y task-gnome-desktop gdm3
      systemctl unmask gdm3.service
      systemctl set-default graphical.target
      systemctl enable --now gdm3.service
      ;;

    ubuntu)
      echo "Ubuntu detected"
