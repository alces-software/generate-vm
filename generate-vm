  --import \
  --ram "${MEM:-2048}" \
  "${MEMORY_ARGS[@]}" \
  --disk "${VM_DISK},device=disk,bus=virtio,target=vda,boot.order=1" \
  --disk "${VM_CONFIG_ISO},device=cdrom,bus=scsi" \
  "${DISK_ARGS[@]}" \
  --vcpus "${CPUS:-2}" \
  --os-variant "${OS_VARIANT}" \
  "${NETWORK_ARGS[@]}" \
  "${FILESHARE_ARGS[@]}" \
  "${DISPLAY_ARGS[@]}" \
  --metadata title="${NAME} created by generate-vm",description="created by generate-vm" \
  --noautoconsole

echo "Setting VNC password..."

virsh qemu-monitor-command "${VMNAME}" \
    --hmp "change vnc password secret12"
EOF

echo
echo "Config ISO created:"
echo "  ${CONFIGISO}"

echo
echo "=========================================="
echo "VMNAME:              ${NAME}"
if [ -n "${INTERNAL_NET_ONLY}" ]; then
	echo "NETWORK MODE: Internal network only"
	echo "INTERNAL MAC: ${INTERNAL_MAC}"
	echo "INTERNAL IP:  ${INTERNAL_IP:-DHCP}"
else
echo "NETWORK MODE:        ${EXTERNAL_NETWORK_MODE}"
echo "EXTERNAL MAC:         ${EXTERNAL_MAC}"
echo "EXTERNAL IP:          ${EXTERNAL_IP:-DHCP}"
fi
echo "=========================================="
if [[ $CONSOLE = "Yes" ]]; then
	virsh console ${NAME}
fi
if [[ $VNCCONSOLE = "Yes" ]]; then
VNC_DISPLAY=$(virsh vncdisplay "${NAME}" 2>/dev/null || true)

if [ -n "${VNC_DISPLAY}" ]; then
	DISPLAY_NUM=${VNC_DISPLAY##*:}
    VNC_PORT=$((5900 + $DISPLAY_NUM))

    echo "VNC display : ${VNC_DISPLAY}"
    echo "VNC port    : ${VNC_PORT}"
    echo "VNC address : $(hostname -s):${VNC_PORT}"
fi

if [ "${GRAPHICAL}" = "Yes" ]; then
	echo "Please wait 4-5 mins before attempting to connect to allow the gui packages to be installed and boot"
fi
echo
echo "to connect to ${NAME} on your machine enter: open \"vnc://:secret12@$(hostname -s):${VNC_PORT}\""
fi
