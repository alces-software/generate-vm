allocate_primary_ip() {

    if [ "${EXTERNAL_NETWORK_MODE}" != "STATIC" ]; then
        echo "External network mode: DHCP"
        return 0
    fi

    if [ -z "${NAME}" ]; then
        echo "ERROR: VMNAME is empty" >&2
        exit 1
    fi

    if [ -z "${EXTERNAL_MAC}" ]; then
        echo "ERROR: EXTERNAL_MAC is empty" >&2
        exit 1
    fi

    echo "Allocating External IP for ${NAME}"

    mkdir -p "${IP_ALLOCATIONS_DIR}"
    touch "${IP_ALLOCATIONS_FILE}"

    (
        flock -x 9

        EXISTING_IP=$(
            awk -v vm="${NAME}" '
                $2 == vm {
                    print $1
                    exit
                }
            ' "${IP_ALLOCATIONS_FILE}"
        )

        if [ -n "${EXISTING_IP}" ]; then
            echo "Existing external IP: ${EXISTING_IP}"
            echo "${EXISTING_IP}" > "/tmp/${NAME}.primary-ip"
            exit 0
        fi

        ip_to_int() {
            local IFS=.
            read -r a b c d <<< "$1"
            echo $(( (a << 24) + (b << 16) + (c << 8) + d ))
        }

        int_to_ip() {
            local ip=$1
            echo "$(( (ip >> 24) & 255 )).$(( (ip >> 16) & 255 )).$(( (ip >> 8) & 255 )).$(( ip & 255 ))"
        }

        START=$(ip_to_int "${EXTERNAL_IP_RANGE_START}")
        END=$(ip_to_int "${EXTERNAL_IP_RANGE_END}")

        for (( IP_INT=START; IP_INT<=END; IP_INT++ )); do

            CANDIDATE_IP=$(int_to_ip "${IP_INT}")

            if ! grep -q "^${CANDIDATE_IP} " "${IP_ALLOCATIONS_FILE}"; then
    echo "${CANDIDATE_IP} ${NAME} ${EXTERNAL_MAC}" \
        >> "${IP_ALLOCATIONS_FILE}"

    echo "${CANDIDATE_IP}" > "/tmp/${NAME}.primary-ip"

    echo "Allocated external IP ${CANDIDATE_IP}"

    exit 0
fi       done

        echo "ERROR: No free IPs in ${EXTERNAL_IP_RANGE_START}-${EXTERNAL_IP_RANGE_END}" >&2
        exit 1

    ) 9>"${IP_ALLOCATIONS_LOCK}"

    # Read the result from the locked subshell.
    if [ ! -f "/tmp/${NAME}.primary-ip" ]; then
        echo "ERROR: IP allocation failed" >&2
        exit 1
    fi

    EXTERNAL_IP=$(cat "/tmp/${NAME}.primary-ip")
    rm -f "/tmp/${NAME}.primary-ip"

    echo "External IP selected: ${EXTERNAL_IP}"
}

