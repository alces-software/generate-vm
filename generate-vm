echo "Starting install"
bash <<'EOF'
#!/bin/bash

set -e

#==============================================
# Variables and dependency checking
#==============================================

VMNAME="${NAME}"

VM_DISK="${VMPATH}/${VMNAME}.qcow2"
VM_CONFIG_ISO="${VMPATH}/${VMNAME}_config.iso"
DISK2_PATH="${VMPATH}/${VMNAME}-disk2.qcow2"

SECONDARY_NETWORK="secondary"
SECONDARY_XML="/tmp/${SECONDARY_NETWORK}.xml"

if ! [ -x /usr/bin/virt-install ]; then
  echo "You need to install libvirt virt-install" >&2
  exit 1
fi

if [ ! -d "${VMPATH}" ]; then
  mkdir -p "${VMPATH}"
fi

if [ -f "${VM_DISK}" ]; then
  echo "A Disk/VM by the name of ${VMNAME} already seems to exist" >&2
  exit 1
fi

if [ -f "${VM_CONFIG_ISO}" ]; then
  echo "A config by that name already exists" >&2
  exit 1
fi

#============================================
# Disk Creation
#============================================

cp -v "${RAWIMAGE}" "${VM_DISK}"
cp -v "${CONFIGISO}" "${VM_CONFIG_ISO}"

echo "Creating Primary Disk.."
qemu-img resize "${VM_DISK}" "${SIZE}"

DISK_ARGS=()

if [ "${DISK2:-}" = "Yes" ]; then
        echo "Creating Second Disk.."
        D2_SIZE="${DISK2SIZE:-30G}"
        qemu-img create -f qcow2 "${DISK2_PATH}" "${D2_SIZE}"
        DISK_ARGS=(
                --disk
                "${DISK2_PATH},device=disk,bus=virtio,target=vdb"
        )
fi

#==========================================
# file sharing
#==========================================

FILESHARE_ARGS=()
MEMORY_ARGS=()

if [ "${FILE_SHARING}" = "Yes" ]; then
        echo "Setting up filesharing"
        SHARED_DIR="/home/rnd/virsh-generator/shared-files/${NAME}"
        mkdir -p "${SHARED_DIR}"
        FILESHARE_ARGS=(
                --filesystem
                "${SHARED_DIR},target.dir=hostshare,driver.type=virtiofs"
        )
        MEMORY_ARGS=(
                --memorybacking source.type=memfd,access.mode=shared
        )
fi

#========================================
# display
#========================================

DISPLAY_ARGS=(
    --graphics "vnc,listen=0.0.0.0,port=-1,password=secret12"
)
if [ "${GRAPHICAL}" = "Yes" ]; then
        echo "Graphical mode enabled"
        DISPLAY_ARGS+=(
            --video vga
        )
else
        echo "Console mode enabled"
        DISPLAY_ARGS+=(
            --console pty,target_type=serial
        )
fi

#===========================================
# Virt-install command
#===========================================
NETWORK_ARGS=(
    --network "bridge=${EXTERNALBRIDGE},mac=${PRIMARY_MAC}"
)

if [ -n "${SECONDARY_IP}" ]; then
    echo "Adding secondary network on bridge vm-secondary"
    NETWORK_ARGS+=(
        --network "bridge=vm-secondary,mac=${SECONDARY_MAC}"
    )
fi

echo "NETWORK_ARGS:"
printf ' %q\n' "${NETWORK_ARGS[@]}"

virt-install \
  --connect qemu:///session \
  --name "${VMNAME}" \
  --import \
  --ram "${MEM:-2048}" \
  "${MEMORY_ARGS[@]}" \
  --disk "${VM_DISK},device=disk,bus=virtio,target=vda,boot.order=1" \
  --disk "${VM_CONFIG_ISO},device=cdrom,bus=scsi" \
  "${DISK_ARGS[@]}" \
  --vcpus "${CPUS:-2}" \
  --os-variant "${OS_VARIANT}" \
  "${NETWORK_ARGS[@]}" \
  "${FILESHARE_ARGS[@]}" \
  "${DISPLAY_ARGS[@]}" \
  --metadata title="${NAME} created by generate-vm",description="created by generate-vm" \
  --noautoconsole

echo "Setting VNC password..."

virsh --connect qemu:///session qemu-monitor-command "${VMNAME}" \
    --hmp "change vnc password secret12"
EOF

echo
echo "Config ISO created:"
echo "  ${CONFIGISO}"

echo
echo "=========================================="
echo "VMNAME:              ${NAME}"
echo "NETWORK MODE:        ${PRIMARY_NETWORK_MODE}"
echo "PRIMARY MAC:         ${PRIMARY_MAC}"
echo "PRIMARY IP:          ${PRIMARY_IP:-DHCP}"
echo "=========================================="
if [[ $CONSOLE = "Yes" ]]; then
	virsh console ${NAME}
fi

VNC_DISPLAY=$(virsh vncdisplay "${NAME}" 2>/dev/null || true)

if [ -n "${VNC_DISPLAY}" ]; then
	DISPLAY_NUM=${VNC_DISPLAY##*:}
    VNC_PORT=$((5900 + $DISPLAY_NUM))

    echo "VNC display : ${VNC_DISPLAY}"
    echo "VNC port    : ${VNC_PORT}"
    echo "VNC address : $(hostname -s):${VNC_PORT}"
fi

if [ "${GRAPHICAL}" = "Yes" ]; then
	echo "Please wait 4-5 mins before attempting to connect to allow the gui packages to be installed and boot"
fi
echo
echo "to connect to ${NAME} on your machine enter: open \"vnc://secret12@$(hostname -s):${VNC_PORT}\""
