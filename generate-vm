release_primary_ip() {
    local vm_name="${1:-${NAME}}"

    if [ -z "${vm_name}" ]; then
        echo "ERROR: VM name is required" >&2
        return 1
    fi

    mkdir -p "${IP_ALLOCATIONS_DIR}"
    touch "${IP_ALLOCATIONS_FILE}"

    (
        flock -x 9

        local existing

        existing=$(awk -v vm="${vm_name}" '
            $2 == vm {
                print $0
                exit
            }
        ' "${IP_ALLOCATIONS_FILE}")

        if [ -z "${existing}" ]; then
            echo "No IP allocation found for ${vm_name}"
            exit 0
        fi

        echo "Releasing IP allocation:"
        echo "  ${existing}"

        awk -v vm="${vm_name}" '
            $2 != vm
        ' "${IP_ALLOCATIONS_FILE}" > "${IP_ALLOCATIONS_FILE}.tmp"

        mv "${IP_ALLOCATIONS_FILE}.tmp" "${IP_ALLOCATIONS_FILE}"

        echo "IP released for ${vm_name}"

    ) 9>"${IP_ALLOCATIONS_LOCK}"
}

