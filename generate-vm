#!/bin/bash

set -e
red=$'\033[1;31m'  
nc=$'\033[0m'
NAME=""
SIZE=""
OS=""
DEFAULT_USER=""

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

VMPATH="/opt/vm"
EXTERNALBRIDGE="ext"
ALMA10_RAWIMAGE="/home/rnd/virsh-generator/images/alma10.qcow2"
ALMA9_RAWIMAGE="/home/rnd/virsh-generator/images/alma9.qcow2"
ALMA8_RAWIMAGE="/home/rnd/virsh-generator/images/alma8.qcow2"
ROCKY10_RAWIMAGE="/home/rnd/virsh-generator/images/rocky10.qcow2"
ROCKY9_RAWIMAGE="/home/rnd/virsh-generator/images/rocky9.qcow2"
ROCKY8_RAWIMAGE="/home/rnd/virsh-generator/images/rocky8.qcow2"
DEBIAN13_RAWIMAGE="/home/rnd/virsh-generator/images/debian13.qcow2"
DEBIAN12_RAWIMAGE="/home/rnd/virsh-generator/images/debian12.qcow2"
DEBIAN11_RAWIMAGE="/home/rnd/virsh-generator/images/debian11.qcow2"
ARCH_RAWIMAGE="/home/rnd/virsh-generator/images/arch.qcow2"
CENTOS10_RAWIMAGE="/home/rnd/virsh-generator/images/centos10.qcow2"
CENTOS9_RAWIMAGE="/home/rnd/virsh-generator/images/centos9.qcow2"
UBUNTU26_RAWIMAGE="/home/rnd/virsh-generator/images/ubuntu26.qcow2"
UBUNTU25_RAWIMAGE="/home/rnd/virsh-generator/images/ubuntu25.qcow2"
UBUNTU24_RAWIMAGE="/home/rnd/virsh-generator/images/ubuntu24.qcow2"


ROOT_PASSWORD="0p3nflight"

CONFIG_FILE="./vm.conf"

SSH_PUBLIC_KEY=""

DISK2=""
DISK2_SIZE=""
MEM=""
CPUS=""
SECONDARY_IP=""
PRIMARY_MAC="$(printf '52:54:00:%02x:%02x:%02x'\
      	$((RANDOM%256))\
      	$((RANDOM%256))\
	$((RANDOM%256)))"

SECONDARY_MAC="$(printf '52:54:00:%02x:%02x:%02x'\
       	$((RANDOM%256))\
       	$((RANDOM%256))\
	$((RANDOM%256)))"

# ---------------------------------------------------------------------------
# Functions
# ---------------------------------------------------------------------------

usage() {
  echo "Usage:"
  echo "  $0 -n NAME -u USER -s SIZE --os OS"
  echo
  echo "Options:"
  echo "  -n, --name NAME                  VM name"
  echo "  -u, --user USER                  Default username"
  echo "  -s, --size SIZE                  Disk size, e.g. 128G"
  echo "      --os OS                      Operating system: alma or arch"
  echo "      --operating-system OS        Same as --os"
  echo "      --cpus (Optional)                            The amount of cpu cores you want the virtual machine to have"
  echo "      if cpus is not added as an option the vm will have access to 2 cpu cores"
  echo "      --memory (Optional)                     The amount of memory you want the virtual machine to have"
  echo "      if memory is not added as am option the vm will have 2048 memory"
  echo "      --ssh                        Public SSH key"
  echo "      --disk2  (Optional)                     Adds a second disk to the vm if --disk2size is not provided it defaults to 30G"
  echo "      if disk2 is not added as an option the vm will boot with 1 disk"
  echo "      --disk2size (Optional)               Allows the specification of the size of disk2"
  echo "      if disk2size is not added as an option but disk2 is the resulting disk will have a size of 30G"
  echo "      --secondary-ip (Optional)		    Joins the vm to a libvirt only network with specified ip"
  echo "      Allows vms which have a secondary-ip set to communicate with each other"
  echo "Commands:"
  echo "      --wizard                     Provides a guided virtual machine creation"
  echo "      --stop                       Stops the specified vm"
  echo "      --destroy                    Destroys and undefines specified vm"
  echo "      --cleanup                    Deletes qcow2 and _config.iso of specified vm"
  echo "      --recreate                   Destroys, undefines, deletes qcow2 and _config.iso of specified vm that creates vm again"
  echo "  -h, --help                       Show this help"
  echo "      --fetch                      Fetches all VM Images from sources"
  echo
  echo "OS Images:"
  echo "alma10"
  echo "alma9"
  echo "alma8"
  echo "arch"
  echo "centos10"
  echo "centos9"
  echo "debian13"
  echo "debian12"
  echo "debian11"
  echo "rocky10"
  echo "rocky9"
  echo "rocky8"
  echo "ubuntu26"
  echo "ubuntu25"
  echo "ubuntu24"
  echo
  echo "Example:"
  echo "  $0 --name myvm --user dev --size 64G --os alma9 --ssh \"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOMqq96Vvclff96Iq1vXOnFp6yS2/7uBwZ8W7aF7Xf9z\" "
}

error() {
  echo "Error: $*" >&2
  exit 1
}

is_valid_ipv4(){
	local ip="$1"
	local IFS=.
	local -a octets

	read -r -a octets <<< "$ip"

	[ "${#octets[@]}" -eq 4 ] || return 1

	for octet in "${octets[@]}"; do

	[[ "$octet" =~ ^[0-9]+$ ]] || return 1

	[[ "$octet" =~ ^0$|^[1-9][0-9]*$ ]] || return 1

	(( octet >= 0 && octet <= 255 )) || return 1

	done

	return 0
}

is_valid_disk_size() {
	local size="$1"

	[[ "$size" =~ ^[1-9][0-9]*G$ ]]
}
wizard() {
    echo "===============Setup Wizard==============="

    read -r -p "What would you like your virtual machine to be called? " vmName
    NAME="$vmName"
    clear

    read -r -p "What would you like the primary user to be called? " userName
    DEFAULT_USER="$userName"
    clear
    while :
    do
    	read -r -p "How large would you like the primary drive to be (in G e.g. 10G)? " primarySize
	if is_valid_disk_size "$primarySize"; then
		SIZE="$primarySize"
		break
	fi
        echo -e "${red}Error: invalid disk size:${nc} $primarySize" >&2
        echo -e "${red} Disk size must be a positive number followed by G, e.g. 10G or 100G${nc}" >&2
    done
    clear

    read -r -p "Would you like the virtual machine to have another drive? " drive2

    if [[ "$drive2" =~ ^([yY]|[yY][eE][sS])$ ]]; then
        clear
        DISK2="Yes"

        while :
	do
        	read -r -p "How large would you like the secondary drive to be (in G e.g. 10G)? " secondarysize
		if is_valid_disk_size "$secondarysize"; then
			DISK2_SIZE="$secondarysize"
			break
		fi
		echo -e "${red}Error: invalid disk size:${nc} $secondarysize" >&2
		echo -e "${red}Disk size must be a positive number followed by G, e.g. 10G or 100G${nc}" >&2
	done
    fi

    clear
    while :
    do
    	read -r -p "How much memory would you like the virtual machine to have (in MB e.g. 2046)? " memsize
        if [[ $memsize =~ ^[0-9]+$ ]]; then
                MEM="$memsize"
		break
        else
                echo -e "${red}Error: invalid memory amount:${nc} $memsize" >&2
        fi
    done
    clear
    
    while :
    do
    	read -r -p "How many CPU cores would you like the virtual machine to have? " cpucores
	if [[ $cpucores =~ ^[0-9]+$ ]]; then
    		CPUS="$cpucores"
		break
	else
		echo -e "${red}Error: invalid cpu core count:${nc} $cpucores" >&2
	fi
    done
    clear

    echo "================OS Choices==============="
    echo "Alma: alma10,alma9,alma8"
    echo "Arch: arch"
    echo "CentOS: centos10, centos9"
    echo "Debian: debian13, debian12, debian11"
    echo "Rocky: rocky10, rocky9, rocky8"
    echo "Ubuntu: ubuntu26, ubuntu25, ubuntu24"
    echo

    while :
do
    read -r -p "Which OS would you like the virtual machine to run? " oschoice

    case "$oschoice" in
        alma10|alma9|alma8|\
        arch|\
        centos10|centos9|\
        debian13|debian12|debian11|\
        rocky10|rocky9|rocky8|\
        ubuntu26|ubuntu25|ubuntu24)
            OS="$oschoice"
            break
            ;;
        *)
            echo -e "${red} Error: invalid OS choice:${nc} $oschoice" >&2
            echo -e "${red} Please choose one of the listed operating systems.${nc}" >&2
            ;;
    esac
done

clear

    while :
do
    read -r -p 'What is your public SSH key? ' sshkey

    if ssh-keygen -l -f <(printf '%s\n' "$sshkey") >/dev/null 2>&1; then
        SSH_PUBLIC_KEY="$sshkey"
        break
    fi

    echo -e "${red}Error: invalid SSH public key.${nc}" >&2
done

clear

    read -r -p "Would you like to include a secondary IP address? " ipaddrq

    if [[ "$ipaddrq" =~ ^([yY]|[yY][eE][sS])$ ]]; then
        clear
	while :
	do
        	read -r -p "What would you like the secondary IP address to be (IPv4 format e.g. 10.0.0.1)? " net2ip
		if is_valid_ipv4 "$net2ip"; then
        		SECONDARY_IP="$net2ip"
			break
		else
			echo -e "${red}Error: invalid ip:${nc} $net2ip" >&2
		fi
	done
    fi

    clear

    cat << 'EOF'
                  .

                   .
         /^\     .
    /\   "V"
   /__\   I      O  o
  //..\\  I     .
  \].`[/  I
  /l\/j\  (]    .  O
 /. ~~ ,\/I          .
 \\L__j^\/I       o
  \/--v}  I     o   .
  |    |  I   _________
  |    |  I c(`       ')o
  |    l  I   \.     ,/
_/j  L l\_!  _//^---^\\_  
EOF
    echo
    echo
    echo "Creating ${NAME}"
    sleep 2
}


# ---------------------------------------------------------------------------
# Parse config file
# ---------------------------------------------------------------------------

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

# ---------------------------------------------------------------------------
# Parse flags
# ---------------------------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--name)
      [[ -n "${2:-}" ]] || error "$1 requires a value"
      NAME="$2"
      shift 2
      ;;

    --name=*)
      NAME="${1#*=}"
      shift
      ;;

      --stop)
    STOP_VM=true
    shift ;;

    --destroy)
    DESTROY_VM=true
    shift;;

    --cleanup)
    CLEAN_UP=true
    shift;;

    --recreate)
    RECREATE=true
    shift;;

    --fetch)
    FETCH=true
    shift;;

    -u|--user)
      [[ -n "${2:-}" ]] || error "$1 requires a value"
      DEFAULT_USER="$2"
      shift 2
      ;;

    --user=*)
      DEFAULT_USER="${1#*=}"
      shift
      ;;

    -s|--size)
      [[ -n "${2:-}" ]] || error "$1 requires a value"
      SIZE="$2"
      shift 2
      ;;

    --size=*)
      SIZE="${1#*=}"
      shift
      ;;

    --os|--operating-system)
      [[ -n "${2:-}" ]] || error "$1 requires a value"
      OS="$2"
      shift 2
      ;;

    --os=*|--operating-system=*)
      OS="${1#*=}"
      shift
      ;;

    --disk2)
	DISK2="Yes"
	shift
	;;

   --disk2size)
	DISK2SIZE="$2"
	if ! is_valid_disk_size "$DISK2SIZE"; then
        echo "Error: invalid disk size: $DISK2SIZE" >&2
        echo "Disk size must be a positive number followed by G, e.g. 10G or 100G" >&2
        exit 1
    fi
	shift 2
	;;

   --disk2size=*)
	DISK2SIZE="${1#*=}"
	if ! is_valid_disk_size "$DISK2SIZE"; then
        echo "Error: invalid disk size: $DISK2SIZE" >&2
        echo "Disk size must be a positive number followed by G, e.g. 10G or 100G" >&2
        exit 1
    fi
	shift 
	;;

   --memory)
	MEM="$2"
	if [[ $MEM =~ ^[0-9]+$ ]]; then
		shift 2
	else
		echo "Error: invalid memory amount: $MEM" >&2
		exit 1
	fi
	;;
   --memory=*)
	MEM="${1#*=}"
	if [[ $MEM =~ ^[0-9]+$ ]]; then
		shift
	else
		echo "Error: invalid memory amount: $MEM" >&2
		exit 1
	fi
	;;
   --cpus)
       CPUS="$2"
       if [[ $CPUS =~ ^[0-9]+$ ]]; then
	       shift 2
       else
	       echo "Error: invalid amount of CPU cores: $CPUS" >&2
       fi
       ;;
   --cpus=*)
       CPUS="${1#*=}"
       if [[ $CPUS =~ ^[0-9]+$ ]]; then
               shift
       else
               echo "Error: invalid amount of CPU cores: $MEM" >&2
       fi
       ;;
   --secondary-ip)
       SECONDARY_IP="$2"
       if ! is_valid_ipv4 "$SECONDARY_IP"; then
        echo "Error: invalid IPv4 address: $SECONDARY_IP" >&2
        exit 1
    fi
       shift 2
       ;;
   --secondary-ip=*)
       SECONDARY_IP="${1#*=}"
       if ! is_valid_ipv4 "$SECONDARY_IP"; then
        echo "Error: invalid IPv4 address: $SECONDARY_IP" >&2
        exit 1
    fi
       shift
       ;;

    -h|--help)
      usage
      exit 0
      ;;

--wizard)
	wizard
	shift
	;;

    --ssh)
	[[ -n "${2:-}" ]] || error "$1 requires a value"
	SSH_PUBLIC_KEY="$2"
	shift 2
	;;
    --ssh=*)
	SSH_PUBLIC_KEY="${1#*=}"
	shift
	;;
    *)
      error "Unknown option: $1"
      ;;
  esac
done

#---------------------------------------------------------------------------
# Stop, Destroy, Cleanup, Recreate Commands
#---------------------------------------------------------------------------

if [ "$STOP_VM" = true ]; then
  if [[ -z $NAME ]]; then
    echo "Error: You must provide a VM name using --name before stopping it."
    exit 1
  fi
  echo "stopping $NAME"
  virsh shutdown "$NAME"
  echo "stopped $NAME"
  exit 0
fi

if [ "$DESTROY_VM" = true ]; then
 if [[ -z $NAME ]]; then
   echo "Error: You must provide a VM name using --name before stopping it."
   exit 1
 fi

 while :
 do
  read -p "Please confirm you wish to destroy $NAME (Y/N) : " destroy_confirm
  if [ "$destroy_confirm" = "Y" ] || [ "$destroy_confirm" = "y" ]; then
	  virsh destroy "$NAME"
	  virsh undefine "$NAME"
	  exit 0
  elif [ "$destroy_confirm" = "N" ] || [ "$destroy_confirm" = "n" ]; then
	  echo "Aborting destruction of $NAME"
	  exit 0
  else
	  echo "Please enter either y or n"
  fi
done
fi

if [ "$CLEAN_UP" = true ]; then
	if [[ -z $NAME ]]; then
		echo "Error: You must provide a VM name using --name before cleaning it up."
		exit 1
	fi
	while :
       	do
		read -p "Please confirm you wish to clean up $NAME\'s files (Y/N) : " clean_confirm
		if [ "$clean_confirm" = "Y" ] || [ "$clean_confirm" = "y" ]; then
			echo "Cleaning up $NAME\'s files"
			rm /opt/vm/${NAME}_config.iso
			rm /opt/vm/${NAME}.qcow2
			rm -f /opt/vm/${NAME}-disk2.qcow2
			exit 0
		elif [ "$clean_confirm" = "N" ] || [ "$clean_confirm" = "n"]; then
			echo "Aborting clean up of $NAME\'s files"
			exit 0
		else
			echo "Please enter either y or n"
		fi
	done
fi

if [ "$RECREATE" = true ]; then
	if [[ -z $NAME ]]; then
		echo "Error: You must provide a VM name using --name before recreating it."
		exit 1
	fi
	while :
       	do
		read -p "Please confirm you wish to recreate $NAME (Y/N) : " recreate_confirm
		if [ "$recreate_confirm" = "Y" ] || [ "$recreate_confirm" = "y" ]; then
			echo "Recreating $NAME"
			virsh shutdown "$NAME"
			sleep 1
			virsh dumpxml --inactive "$NAME" >  /tmp/recreated_vm.xml
			virsh undefine "$NAME"
			virsh define /tmp/recreated_vm.xml
			virsh start "$NAME"
			virsh console "$NAME"

			exit 0
		elif [ "$recreate_confirm" = "N" ] || [ "$recreate_confirm" = "n" ]; then
			echo "Aborting recreation of $NAME"
			exit 0
		else
			echo "Please enter either y or n"
		fi
	done
fi

if [ "$FETCH" = true ]; then
	mkdir -p images
	cd images
	wget -O alma10.qcow2 https://repo.almalinux.org/almalinux/10/cloud/x86_64_v2/images/AlmaLinux-10-GenericCloud-latest.x86_64_v2.qcow2
	wget -O alma9.qcow2 https://repo.almalinux.org/almalinux/9/cloud/x86_64/images/AlmaLinux-9-GenericCloud-latest.x86_64.qcow2
	wget -O alma8.qcow2 https://repo.almalinux.org/almalinux/8/cloud/x86_64/images/AlmaLinux-8-GenericCloud-latest.x86_64.qcow2
	wget -O arch.qcow2 https://fastly.mirror.pkgbuild.com/images/v20260901.583572/Arch-Linux-x86_64-cloudimg.qcow2
	wget -O centos10.qcow2 https://cloud.centos.org/centos/10-stream/x86_64/images/CentOS-Stream-GenericCloud-10-latest.x86_64.qcow2
	wget -O centos9.qcow2 https://cloud.centos.org/centos/9-stream/x86_64/images/CentOS-Stream-GenericCloud-9-latest.x86_64.qcow2
	wget -O debian13.qcow2 https://cloud.debian.org/images/cloud/trixie/20260831-2587/debian-13-genericcloud-amd64-20260831-2587.qcow2
	wget -O debian12.qcow2 https://cloud.debian.org/images/cloud/bookworm/20260903-2590/debian-12-genericcloud-amd64-20260903-2590.qcow2
	wget -O debian11.qcow2 https://cloud.debian.org/images/cloud/bullseye/20260821-2577/debian-11-genericcloud-amd64-20260821-2577.qcow2
	wget -O ubuntu26.qcow2 https://cloud-images.ubuntu.com/resolute/current/resolute-server-cloudimg-amd64v3.img
	wget -O ubuntu25.qcow2 https://cloud-images.ubuntu.com/questing/current/questing-server-cloudimg-amd64.img
	wget -O ubuntu24.qcow2 https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img
	wget -O rocky10.qcow2 https://rockylinux.mirrorservice.org/pub/rocky/10.2/images/x86_64/Rocky-10-GenericCloud-Base.latest.x86_64.qcow2
	wget -O rocky9.qcow2 https://rockylinux.mirrorservice.org/pub/rocky/9/images/x86_64/Rocky-9-GenericCloud-Base.latest.x86_64.qcow2
	wget -O rocky8.qcow2 https://rockylinux.mirrorservice.org/pub/rocky/8/images/x86_64/Rocky-8-GenericCloud-Base.latest.x86_64.qcow2
	cd ..
	echo "VM Images Successfully Downloaded"
	exit 0
fi

# ---------------------------------------------------------------------------
# Validate arguments
# ---------------------------------------------------------------------------

[[ -n "$NAME" ]] || error "VM name is required. Use --name NAME"

[[ -n "$DEFAULT_USER" ]] || error "Default user is required. Use --user USER"

[[ -n "$SIZE" ]] || error "Disk size is required. Use --size SIZE"

[[ -n "$SSH_PUBLIC_KEY" ]] || error "SSH_PUBLIC_KEY is required in ${CONFIG_FILE}"

OS=$(printf '%s' "$OS" | tr '[:upper:]' '[:lower:]')

case "$OS" in
  alma10)
    RAWIMAGE="$ALMA10_RAWIMAGE"
    OS_VARIANT="almalinux10"
    ;;
  alma9)
    RAWIMAGE="$ALMA9_RAWIMAGE"
    OS_VARIANT="almalinux9"
    ;;
  alma8)
   RAWIMAGE="$ALMA8_RAWIMAGE"
   OS_VARIANT="almalinux8"
   ;;
  rocky10)
   RAWIMAGE="$ROCKY10_RAWIMAGE"
   OS_VARIANT="rocky10"
   ;;
  rocky9)
   RAWIMAGE="$ROCKY9_RAWIMAGE"
   OS_VARIANT="rocky9"
   ;;
  rocky8)
   RAWIMAGE="$ROCKY8_RAWIMAGE"
   OS_VARIANT="rocky8"
   ;;
  debian13)
   RAWIMAGE="$DEBIAN13_RAWIMAGE"
   OS_VARIANT="debian13"
   ;;
  debian12)
   RAWIMAGE="$DEBIAN12_RAWIMAGE"
   OS_VARIANT="debian12"
   ;;
  debian11)
   RAWIMAGE="$DEBIAN11_RAWIMAGE"
   OS_VARIANT="debian1"
  ;;   
  arch)
    RAWIMAGE="$ARCH_RAWIMAGE"
    OS_VARIANT="archlinux"
    ;;
  centos10)
    RAWIMAGE="$CENTOS10_RAWIMAGE"
    OS_VARIANT="centos-stream10"
    ;;
  centos9)
    RAWIMAGE="$CENTOS9_RAWIMAGE"
    OS_VARIANT="centos-stream9"
    ;;
  ubuntu26)
    RAWIMAGE="$UBUNTU26_RAWIMAGE"
    OS_VARIANT="ubuntu-stable-latest"
    ;;
  ubuntu25)
    RAWIMAGE="$UBUNTU25_RAWIMAGE"
    OS_VARIANT="ubuntuquesting"
    ;;
   ubuntu24)
    RAWIMAGE="$UBUNTU24_RAWIMAGE"
    OS_VARIANT="ubuntunoble"
    ;;

  *)
    error "Invalid operating system: $OS. Valid values are: alma10, alma9, alma8, arch, centos10, centos9, debian13, debian12, debian11, rocky10, rocky9, rocky8, ubuntu26, ubuntu25, ubuntu24"
    ;;
esac

# Basic name validation. This also prevents accidentally generating paths
# containing / or other unexpected characters.
if [[ ! "$NAME" =~ ^[a-zA-Z0-9._-]+$ ]]; then
  error "Invalid VM name: $NAME"
fi

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

IMAGEISO="/tmp/imageiso"
CONFIGISO="${IMAGEISO}/config.iso"

VM_SCRIPT="${PWD}/${NAME}-create.sh"

VM_DISK="${VMPATH}/${NAME}.qcow2"
VM_CONFIG_ISO="${VMPATH}/${NAME}_config.iso"

# ---------------------------------------------------------------------------
# Check prerequisites
# ---------------------------------------------------------------------------

if ! command -v mkisofs >/dev/null 2>&1; then
  error "mkisofs is not installed"
fi

if ! command -v qemu-img >/dev/null 2>&1; then
  error "qemu-img is not installed"
fi

if ! command -v virt-install >/dev/null 2>&1; then
  error "You need to install libvirt virt-install"
fi

if [[ ! -f "$RAWIMAGE" ]]; then
  error "Raw image does not exist: $RAWIMAGE"
fi

# ---------------------------------------------------------------------------
# Generate the config ISO script
# ---------------------------------------------------------------------------
CONFIG_SCRIPT="/tmp/${NAME}-generate-config-iso.sh"

echo "Generating config ISO script: ${CONFIG_SCRIPT}"

cat > "$CONFIG_SCRIPT" <<EOF
#!/bin/bash

set -e

echo "Generating config ISO"

if [ -d /tmp/imageiso ]; then
  rm -rf /tmp/imageiso
fi

mkdir -p /tmp/imageiso

META=/tmp/imageiso/meta-data
USER=/tmp/imageiso/user-data
ISO=/tmp/imageiso/config.iso
NET=/tmp/imageiso/network-config

cat <<'METAEOF' > \$META
instance-id: iid-${NAME}
dsmode: local
local-hostname: ${NAME}
hostname: ${NAME}
fqdn: ${NAME}.dmz.alces-software.com
public-keys:
  - ${SSH_PUBLIC_KEY}
METAEOF

cat <<'USEREOF' > \$USER
#cloud-config
disable_root: 0
ssh_pwauth: 1

chpasswd:
  list: |
    root:${ROOT_PASSWORD}
    ${DEFAULT_USER}:${ROOT_PASSWORD}

system_info:
  default_user:
    name: ${DEFAULT_USER}
    lock_passwd: false
    gecos: Local Administrator
    groups: [wheel, adm, systemd-journal]
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    shell: /bin/bash
USEREOF

if [ "${DISK2:-}" = "Yes" ]; then

cat <<'DISKEOF' >> "\$USER"
fs_setup:
- label: data_disk
  filesystem: 'ext4'
  device: /dev/vdb
  partition: auto

mounts:
- [ /dev/vdb, /mnt/data, "ext4", "defaults,nofail", "0", "2" ]
DISKEOF
fi

cat <<'NETEOF' > "\$NET"
version: 2
ethernets:
  primary:
    match:
      macaddress: "${PRIMARY_MAC}"
    dhcp4: true
    dhcp6: false
NETEOF

if [ -n "${SECONDARY_IP}" ]; then
cat <<'NETEOF' >> "\$NET"
  secondary:
    match:
      macaddress: "${SECONDARY_MAC}"
    dhcp4: false
    dhcp6: false
    addresses:
      - ${SECONDARY_IP}/24
NETEOF
fi

echo "net config"
cat "\$NET"

mkisofs -o "\$ISO" -V cidata -J "\$META" "\$USER" "\$NET"

echo "Created \$ISO"
EOF

chmod +x "$CONFIG_SCRIPT"

"$CONFIG_SCRIPT"

echo "end of config"

# ---------------------------------------------------------------------------
# Generate VM creation script
# ---------------------------------------------------------------------------

bash <<EOF
#!/bin/bash

set -e

VMNAME="${NAME}"
EXTERNALBRIDGE="${EXTERNALBRIDGE}"
CONFIGISO="${CONFIGISO}"
RAWIMAGE="${RAWIMAGE}"
MEM="${MEM}"
CPUS="${CPUS}"

VMPATH="${VMPATH}"
DISK2="${DISK2}"
DISK2SIZE="${DISK2SIZE}"
VM_DISK="\${VMPATH}/\${VMNAME}.qcow2"
VM_CONFIG_ISO="\${VMPATH}/\${VMNAME}_config.iso"
DISK2_PATH="\${VMPATH}/\${VMNAME}-disk2.qcow2"

SECONDARY_NETWORK="secondary"
SECONDARY_XML="/tmp/\${SECONDARY_NETWORK}.xml"
SECONDARY_IP="${SECONDARY_IP:-}"
if ! [ -x /usr/bin/virt-install ]; then
  echo "You need to install libvirt virt-install" >&2
  exit 1
fi

if [ ! -d "\${VMPATH}" ]; then
  mkdir -p "\${VMPATH}"
fi

if [ -f "\${VM_DISK}" ]; then
  echo "A Disk/VM by the name of \${VMNAME} already seems to exist" >&2
  exit 1
fi

if [ -f "\${VM_CONFIG_ISO}" ]; then
  echo "A config by that name already exists" >&2
  exit 1
fi

if [ -n "${SECONDARY_IP}" ]; then
	echo "Checking Libvirt secondary network"
	
	if ! virsh net-info "\${SECONDARY_NETWORK}" >/dev/null 2>&1; then
		echo "Creating Libvirt secondary network"

		printf '%s\n' \
		'<network>' \
		" <name>secondary</name>" \
		' <bridge name="virbr-secondary"/>' \
		'</network>' \
		> "\${SECONDARY_XML}"
		virsh net-define "\${SECONDARY_XML}"
	fi
virsh net-autostart secondary >/dev/null

if ! virsh  net-info "\${SECONDARY_NETWORK}" \
  | grep -q '^Active:.*yes'; then
  
  echo "Starting Libvirt secondary network"
  virsh net-start "\${SECONDARY_NETWORK}"
fi
rm -f "\${SECONDARY_XML}"
echo "Secondary network ready"
fi	


cp -v "\${RAWIMAGE}" "\${VM_DISK}"
cp -v "\${CONFIGISO}" "\${VM_CONFIG_ISO}"

echo "Creating Primary Disk.."
qemu-img resize "\${VM_DISK}" "${SIZE}"

DISK_ARGS=()

if [ "\${DISK2:-}" = "Yes" ]; then
	echo "Creating Second Disk.."
	D2_SIZE="\${DISK2SIZE:-30G}"
	qemu-img create -f qcow2 "\${DISK2_PATH}" "\${D2_SIZE}"
	DISK_ARGS=(
		--disk
		"\${DISK2_PATH},device=disk,bus=virtio,target=vdb"
	)
fi

NETWORK_ARGS=(
	--network "bridge=${EXTERNALBRIDGE},mac=${PRIMARY_MAC}"
)

if [ -n "${SECONDARY_IP}" ]; then
	echo "Adding secondary NIC on Libvirt network '\${SECONDARY_NETWORK}'"
	
	NETWORK_ARGS+=(
		--network "network=\${SECONDARY_NETWORK},mac=${SECONDARY_MAC}"
	)
fi
echo "NETWORK_ARGS:"
printf ' %q\n' "\${NETWORK_ARGS[@]}"
virt-install \\
  --name "\${VMNAME}" \\
  --import \\
  --ram "\${MEM:-2048}" \\
  --disk "\${VM_DISK},device=disk,bus=virtio,target=vda,boot.order=1" \\
  --disk "\${VM_CONFIG_ISO},device=cdrom,bus=scsi" \\
  "\${DISK_ARGS[@]}" \\
  --vcpus "\${CPUS:-2}" \\
  --os-variant "${OS_VARIANT}" \\
  "\${NETWORK_ARGS[@]}" \\
  --console pty,target_type=serial \\
  --graphics vnc,listen=0.0.0.0,port=-1 \\
  --noautoconsole 
EOF

echo
echo "Config ISO created:"
echo "  ${CONFIGISO}"

virsh console ${NAME}
